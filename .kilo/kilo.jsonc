{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "mobile-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-docker"
      ],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/zia/Documents/My Projects/Authenticator"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/home/zia/.local/share/kilo/memory.json"
      }
    },
    "sentry": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sentry/mcp-server@latest"
      ],
      "environment": {
        "SENTRY_ACCESS_TOKEN": "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"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/home/zia/Documents/My Projects/Authenticator"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "firebase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firebase-tools",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "android-emulator": {
      "type": "local",
      "command": [
        "npx",
        "mcp-android-emulator"
      ],
      "environment": {
        "ADB_PATH": "/home/zia/Android/Sdk/platform-tools/adb"
      },
      "enabled": true
    },
    "maestro": {
      "type": "local",
      "command": [
        "maestro",
        "mcp"
      ],
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true
    },
    "gradle-mcp": {
      "type": "local",
      "command": [
        "jbang",
        "run",
        "--quiet",
        "--fresh",
        "gradle-mcp@rnett"
      ],
      "environment": {
        "GRADLE_MCP_PROJECT_ROOT": "/home/zia/Documents/My Projects/Authenticator/authenticator-app",
        "PATH": "/home/zia/.maestro/bin:/home/zia/.local/bin:/usr/local/bin:/usr/bin:/bin:/home/zia/Android/Sdk/platform-tools"
      },
      "enabled": true
    },
    "gcloud": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "enabled": true
    },
    "rhizome-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rhizome-mcp",
        "serve",
        "--project-root",
        "/home/zia/Documents/My Projects/Authenticator"
      ],
      "enabled": true
    }
  }
}