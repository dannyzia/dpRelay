root = true

[*.{kt,kts}]
charset=utf-8
indent_style=space
indent_size=2
continuation_indent_size=2
max_line_length=120
end_of_line=lf
insert_final_newline=true
trim_trailing_whitespace=true

[*.{xml,json,yml,yaml}]
indent_style=space
indent_size=2
end_of_line=lf
insert_final_newline=true
trim_trailing_whitespace=true
