VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# ── dP Relay v5 dashboard slice (/v5/*) ─────────────────────────────────
# Base URL of the v5 API server. Leave EMPTY for same-origin (Cloudflare Pages
# with a /v5 reverse proxy, or the vite dev proxy) or set the absolute https://
# URL of the Render service for cross-origin use.
VITE_V5_API_BASE_URL=
