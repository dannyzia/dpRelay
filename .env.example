[TEMPLATE]
# Authenticator App Environment Variables
# Copy this file to .env and fill in the actual values

# Cloud Functions URL (no trailing slash)
CF_URL=https://asia-southeast1-phone-auth.cloudfunctions.net

# Firebase Secrets (set via Firebase CLI: firebase functions:secrets:set)
# VERIFICATION_SIGNING_SECRET
# AUTHENTICATOR_ENROLLMENT_SECRET
# HEALTH_ADMIN_SECRET
# ACTIVE_DEDICATED_NUMBER
RIDE_BACKEND_URL=
DPRELAY_INBOUND_SECRET=

# Firebase Project Configuration
FIREBASE_PROJECT_ID=PhoneAuthService

# ---------------------------------------------------------------------------
# dP Relay v5 server (server/ — see server/.env.example for the full contract)
# ---------------------------------------------------------------------------
# JWT access-token signing secret (REQUIRED for the v5 server; min 32 chars)
# (ISSUE-13: leaving this unset on Render killed every boot — fail-fast config.)
# Generate: openssl rand -base64 32
JWT_SECRET=
# Token lifetimes in seconds (defaults: 15 min access, 30-day refresh)
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# Heartbeat watchdog: staleness threshold (default 900s = 15 min) + cron schedules
WATCHDOG_STALE_SEC=900
WATCHDOG_CRON=*/5 * * * *
CATCH_UP_CRON=*/10 * * * *
# Watchdog alert webhook (empty = log-only); optional bearer secret
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Idle seconds before a request counts as a wake (Render spin-down guard)
WAKE_IDLE_THRESHOLD_SEC=900
# Device enrollment secret (POST /v5/device/enroll; empty = enrollment disabled)
DEVICE_ENROLLMENT_SECRET=
# Claimed pending_sms requeue window for at-least-once outstanding fetch
OUTSTANDING_REQUEUE_SEC=120
ENROLL_RATE_MAX_PER_HOUR=10
ENROLL_RATE_WINDOW_SEC=3600
# Operator app-provisioning secret (POST /v5/apps/register; empty = disabled)
APP_PROVISIONING_SECRET=
APP_PROVISIONING_RATE_MAX_PER_HOUR=10
APP_PROVISIONING_RATE_WINDOW_SEC=3600
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SEC=900
# Firebase service-account JSON (stringified) — FCM wake sender only
FCM_SERVICE_ACCOUNT_JSON=
# OTP webhook dispatch (signed otp.status deliveries to app webhook URLs)
# Hard per-attempt timeout (ms) and retry backoff delays (ms, last value repeats)
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_DELAYS_MS=30000,120000
# Consecutive exhausted webhook dispatches per app before the alert channel fires
WEBHOOK_EXHAUSTION_ALERT_THRESHOLD=3
# Minimum seconds between exhaustion alerts for the SAME app (dead-receiver damping)
WEBHOOK_EXHAUSTION_DAMPING_SEC=3600
# Minimum seconds between OTP sends to the SAME phone per app (resend cooldown)
OTP_RESEND_COOLDOWN_SEC=60

# -- M4 billing plane (ISSUE-14 pass 1) --------------------------------------
# Shared secret for operator/admin routes (requireOperator). Empty = admin routes disabled.
OPERATOR_SECRET=
# bKash "Send Money" destination shown to customers on credit request. Empty = requests fail closed.
BKASH_PERSONAL_NUMBER=

# -- M4 campaigns plane (ISSUE-14 pass 2) -------------------------------------
# Bulk campaigns master switch (default off). Queue tick, rate budget,
# backpressure, retry cap, per-campaign/per-day limits, charset caps,
# post-send cooldown, and the stats snapshot cadence.
BULK_ENABLED=false
BULK_QUEUE_CRON=*/1 * * * *
BULK_SMS_RATE_PER_MINUTE=30
BULK_MAX_PENDING_QUEUE=100
BULK_RETRY_MAX_ATTEMPTS=3
BULK_SMS_PER_CAMPAIGN_LIMIT=10000
BULK_DAILY_APP_LIMIT=50000
BULK_MAX_MESSAGE_CHARS_GSM=160
BULK_MAX_MESSAGE_CHARS_UCS2=70
BULK_POST_SEND_COOLDOWN_SEC=120
STATS_CRON=*/15 * * * *
