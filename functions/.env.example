# Cloud Functions Environment Variables
# Copy this file to .env and fill in real values.
# All secrets must be generated before deployment.

# VERIFICATION_SIGNING_SECRET (32+ characters)
# Used for HMAC-SHA256 signing of verification challenges
# Generate: openssl rand -base64 32
VERIFICATION_SIGNING_SECRET=

# AUTHENTICATOR_ENROLLMENT_SECRET (32+ characters)
# Used for authenticator device registration
# Generate: openssl rand -base64 32
AUTHENTICATOR_ENROLLMENT_SECRET=

# HEALTH_ADMIN_SECRET (32+ characters)
# Used for health endpoint authentication
# Generate: openssl rand -base64 32
HEALTH_ADMIN_SECRET=

# ACTIVE_DEDICATED_NUMBER (E.164 format)
# The phone number of the dedicated authenticator device
# Example: +8801XXXXXXXXX
ACTIVE_DEDICATED_NUMBER=

# APP_MASTER_SECRET (48+ characters, min 32)
# Root of trust for multi-tenant app registry (registerApp/revokeApp)
# Used to validate app registration requests and hash API keys
# Generate: openssl rand -base64 48
APP_MASTER_SECRET=

# BKASH_PERSONAL_NUMBER
# bKash Send Money number for credit top-ups
# Do NOT use a real number in this example file
BKASH_PERSONAL_NUMBER=

# BKASH_MIN_TOPUP_AMOUNT
# Minimum acceptable BDT per top-up
BKASH_MIN_TOPUP_AMOUNT=500

# Bulk SMS configuration
# Maximum entries queued per campaign per minute
BULK_SMS_RATE_PER_MINUTE=30

# Max bulk jobs in /pending_sms globally
BULK_MAX_PENDING_QUEUE=100

# Max retries re-queued per minute
BULK_RETRY_BUDGET_PER_MINUTE=10

# Hard cap per single campaign
BULK_SMS_PER_CAMPAIGN_LIMIT=10000

# Max daily bulk SMS per app per UTC day
BULK_DAILY_APP_LIMIT=50000

# SMS message length limits by charset
BULK_MAX_MESSAGE_CHARS_GSM=160
BULK_MAX_MESSAGE_CHARS_UCS2=70

# Maximum retry attempts per recipient
BULK_RETRY_MAX_ATTEMPTS=3

# Timeout after which errored pending_sms entries are considered stale
BULK_STALE_ENTRY_TIMEOUT_MS=300000 # 5 minutes
