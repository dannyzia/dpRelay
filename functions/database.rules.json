{
  "rules": {
    "verification_requests": {
      "$sessionCode": {
        ".read": "auth != null && auth.token.role == 'authenticator'",
        ".write": "auth != null && auth.token.role == 'authenticator'",
        ".validate": "newData.hasChildren(['userPhone', 'createdAt', 'expiresAt', 'challengeToken'])",
        "userPhone": {
          ".validate": "newData.isString() && newData.val().matches(/^\\+[1-9]\\d{1,14}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now"
        },
        "challengeToken": {
          ".validate": "newData.isString() && newData.val().length >= 10"
        },
        "receipt": {
          ".write": "auth != null && auth.token.role == 'authenticator'",
          ".validate": "newData.hasChildren(['receivedAt', 'sender', 'challengeToken'])",
          "receivedAt": {
            ".validate": "newData.isNumber()"
          },
          "sender": {
            ".validate": "newData.isString()"
          },
          "challengeToken": {
            ".validate": "newData.isString() && newData.val().length >= 10"
          },
          "device": {
            ".validate": "newData.isString()"
          }
        }
      },
      ".indexOn": ["createdAt"]
    },
    "health": {
      "$androidId": {
        ".read": "auth != null && auth.token.role == 'authenticator'",
        ".write": "auth != null && auth.token.role == 'authenticator'",
        ".validate": "newData.hasChildren(['lastPing', 'battery', 'device'])",
        "lastPing": {
          ".validate": "newData.isNumber()"
        },
        "battery": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "device": {
          ".validate": "newData.isString()"
        }
      },
      ".indexOn": ["lastPing"]
    },
    "registered_apps": {
      "$appId": {
        ".read": "auth != null && (auth.token.admin == true || auth.uid == data.child('ownerUid').val())",
        ".write": "auth != null && auth.token.admin == true"
      }
    },
    "pending_sms": {
      "$sessionId": {
        ".read": "auth != null && (auth.token.admin == true || auth.token.role == 'authenticator')",
        ".write": "false"
      }
    },
    "otp_requests": {
      "$sessionId": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "false"
      }
    },
    "otp_verify_receipts": {
      "$sessionId": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "false"
      },
      ".indexOn": ["expiresAt"]
    },
    "stats": {
      ".read": "auth != null",
      ".write": "false"
    },
    "webhook_failures": {
      "$failureId": {
        ".read": "auth != null && auth.token.admin == true",
        ".write": "false"
      }
    },
    "bulk_progress": {
      "$campaignId": {
        ".read": "auth != null",
        ".write": "false"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    }
  }
}
