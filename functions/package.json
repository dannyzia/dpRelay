{
  "name": "phone-auth-functions",
  "version": "4.0.2",
  "description": "Cloud Functions for Phone Authenticator v4",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --coverage --forceExit",
    "test:unit": "jest index.test.js --no-coverage",
    "test:integration": "firebase emulators:exec --only firestore,database,auth 'jest --no-coverage --forceExit'",
    "test:all": "firebase emulators:exec --only firestore,database,auth 'jest --coverage --forceExit'",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0"
  },
  "private": true
}
