[TEMPLATE]
# dP Relay v5 server — copy to .env for local dev; set in Render dashboard for prod
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DB_PATH=./data/dprelay.db

# --- Auth (M1) ---
# JWT access-token signing secret. REQUIRED — server refuses to boot without it.
# Generate: openssl rand -base64 32
JWT_SECRET=
# Token lifetimes, in seconds (defaults shown)
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- Heartbeat watchdog (M1) ---
# A device is stale when last_seen_at is older than WATCHDOG_STALE_SEC (default 900 = 15 min)
WATCHDOG_STALE_SEC=900
# Cron schedules (node-cron patterns; server timezone)
WATCHDOG_CRON=*/5 * * * *
CATCH_UP_CRON=*/10 * * * *
# Watchdog alert delivery. ALERT_WEBHOOK_URL empty = log-only alerts.
# ALERT_WEBHOOK_SECRET is sent as `Authorization: Bearer <secret>` when set.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Device plane (M2, PLAN §7) ---
# Shared secret for phone enrollment (POST /v5/device/enroll). EMPTY = enrollment
# disabled (the route 403s). Send as `Authorization: Bearer <secret>`.
# Generate: openssl rand -base64 32
DEVICE_ENROLLMENT_SECRET=
# Claimed pending_sms older than this are re-offered to the next fetch (at-least-once)
OUTSTANDING_REQUEUE_SEC=120
ENROLL_RATE_MAX_PER_HOUR=10
ENROLL_RATE_WINDOW_SEC=3600

# --- Litestream → Cloudflare R2 (R2 constraint; see docs/httpsms vs dprelay/Modification 6/SETUP-R2.md) ---
# start-server.mjs: when true (or unset — durability-first default), runs
# `litestream restore -if-db-not-exists` BEFORE the API starts, then supervises
# the API under `litestream replicate`. Set false ONLY for local dev.
LITESTREAM_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LITESTREAM=dprelay-litestream
R2_BUCKET_ATTACHMENTS=dprelay-attachments
