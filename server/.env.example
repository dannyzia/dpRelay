# dP Relay v5 server — copy to .env for local dev; set in Render dashboard for prod
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DB_PATH=./data/dprelay.db

# Litestream → Cloudflare R2 (see docs/httpsms vs dprelay/Modification 6/SETUP-R2.md)
# Fill these in Render env vars when the restore-on-boot entrypoint ships (M1 follow-up)
LITESTREAM_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LITESTREAM=dprelay-litestream
R2_BUCKET_ATTACHMENTS=dprelay-attachments
