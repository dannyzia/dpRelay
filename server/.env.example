[TEMPLATE]
# dP Relay v5 server — copy to .env for local dev; set in Render dashboard for prod
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DB_PATH=./data/dprelay.db

# --- Auth (M1) ---
# JWT access-token signing secret. REQUIRED — server refuses to boot without it.
# (ISSUE-13: every deploy since 2026-09-16 failed at boot because this was unset
# on Render — fail-fast config + missing secret = deploy killed in ~40s.)
# Generate: openssl rand -base64 32
JWT_SECRET=
# Token lifetimes, in seconds (defaults shown)
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- Heartbeat watchdog (M1) ---
# A device is stale when last_seen_at is older than WATCHDOG_STALE_SEC (default 900 = 15 min)
WATCHDOG_STALE_SEC=900
# Cron schedules (node-cron patterns; server timezone)
WATCHDOG_CRON=*/5 * * * *
CATCH_UP_CRON=*/10 * * * *
# Watchdog alert delivery. ALERT_WEBHOOK_URL empty = log-only alerts.
# ALERT_WEBHOOK_SECRET is sent as `Authorization: Bearer <secret>` when set.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Device plane (M2, PLAN §7) ---
# Shared secret for phone enrollment (POST /v5/device/enroll). EMPTY = enrollment
# disabled (the route 403s). Send as `Authorization: Bearer <secret>`.
# Generate: openssl rand -base64 32
DEVICE_ENROLLMENT_SECRET=
# Claimed pending_sms older than this are re-offered to the next fetch (at-least-once)
OUTSTANDING_REQUEUE_SEC=120
ENROLL_RATE_MAX_PER_HOUR=10
ENROLL_RATE_WINDOW_SEC=3600
# Shared secret for OPERATOR app provisioning (POST /v5/apps/register) — registers
# appId/appSecret and mints webhook_secret once. EMPTY = provisioning disabled
# (the route 403s). Send as `Authorization: Bearer <secret>`; never expose to clients.
# Generate: openssl rand -base64 32
APP_PROVISIONING_SECRET=
APP_PROVISIONING_RATE_MAX_PER_HOUR=10
APP_PROVISIONING_RATE_WINDOW_SEC=3600
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SEC=900
# Firebase service-account JSON (stringified) — FCM wake sender only
FCM_SERVICE_ACCOUNT_JSON=

# --- OTP webhook dispatch (M3 tail) ---
# When a phone reports a result for an OTP-linked message, the server POSTs a
# signed { kind: "otp.status" } payload to the owning app's webhook_url with
# X-DP-Signature: hex(HMAC-SHA256(rawBody, webhook_secret)). No webhook
# configured on the app = no dispatch. Retries: 3 attempts total.
# Hard timeout per attempt, milliseconds
WEBHOOK_TIMEOUT_MS=5000
# Comma-separated backoff delays (ms) between retry attempts (last value repeats)
WEBHOOK_RETRY_DELAYS_MS=30000,120000
# After this many CONSECUTIVE exhausted dispatches for one app, fire the watchdog
# ALERT_WEBHOOK_URL channel (webhook_exhaustion alert). Any success resets the count.
WEBHOOK_EXHAUSTION_ALERT_THRESHOLD=3

# --- Litestream → Cloudflare R2 (R2 constraint; see docs/httpsms vs dprelay/Modification 6/SETUP-R2.md) ---
# start-server.mjs: when true (or unset — durability-first default), runs
# `litestream restore -if-db-not-exists` BEFORE the API starts, then supervises
# the API under `litestream replicate`. Set false ONLY for local dev.
LITESTREAM_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LITESTREAM=dprelay-litestream
R2_BUCKET_ATTACHMENTS=dprelay-attachments
