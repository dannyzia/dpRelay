{
  "name": "dprelay-server",
  "version": "5.2.0-alpha.0",
  "description": "dP Relay v5 API server (Modification 6 — Firebase exit)",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/download-litestream.mjs && tsc -p tsconfig.json",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^8.0.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.7.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
